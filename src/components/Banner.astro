---
interface Props {
  title: string;
  subtitle: string;
}
const { title, subtitle } = Astro.props;
---

<section class="banner" aria-label="Site banner">
  <svg class="lattice" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
    <defs>
      <pattern id="lattice" width="48" height="48" patternUnits="userSpaceOnUse">
        <path d="M0 0 L48 48 M48 0 L0 48 M24 0 V48 M0 24 H48" fill="none" stroke="#f6f1e4" stroke-width="1" />
        <circle cx="0" cy="0" r="2.5" fill="#f6f1e4" />
        <circle cx="24" cy="24" r="2.5" fill="#f6f1e4" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#lattice)" />
  </svg>
  <div class="banner-text">
    <p class="banner-title">{title}</p>
    <p class="banner-sub">{subtitle}</p>
  </div>
</section>
