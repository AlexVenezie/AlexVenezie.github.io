---
import Layout from '../../layouts/Layout.astro';
import Band from '../../components/Band.astro';
import NewsItem from '../../components/NewsItem.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="News">
  <Band tone="sand">
    <h1>News</h1>
  </Band>
  <Band tone="sage">
    {items.map((n) => <NewsItem entry={n} />)}
  </Band>
</Layout>
