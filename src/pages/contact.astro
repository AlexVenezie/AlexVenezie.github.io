---
import Layout from '../layouts/Layout.astro';

// TODO: create a free form at https://formspree.io and paste your form endpoint here.
// A static site cannot receive messages itself, so this posts to that service, which emails you.
const FORM_ENDPOINT = 'https://formspree.io/f/YOUR_FORM_ID';
---

<Layout title="Contact">
  <h1>Contact</h1>
  <p>
    I'm happy to hear from prospective students, collaborators, journalists and anyone curious
    about my work. Send a message below, or email me directly at
    <a href="mailto:you@wustl.edu">you@wustl.edu</a>.
  </p>

  <form action={FORM_ENDPOINT} method="POST">
    <label>
      Name
      <input type="text" name="name" required />
    </label>
    <label>
      Email
      <input type="email" name="email" required />
    </label>
    <label>
      Message
      <textarea name="message" rows="6" required></textarea>
    </label>
    <button type="submit">Send</button>
  </form>

  <h2>Elsewhere</h2>
  <ul>
    <li><a href="https://github.com/AlexVenezie">GitHub</a></li>
    <!-- TODO: add Google Scholar, ORCID, LinkedIn -->
  </ul>
</Layout>
