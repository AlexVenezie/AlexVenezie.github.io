---
import Layout from '../layouts/Layout.astro';
import Band from '../components/Band.astro';

// A static site cannot receive messages itself, so this posts to Formspree, which emails them to me.
const FORM_ENDPOINT = 'https://formspree.io/f/xwloowaa';
---

<Layout title="Contact">
  <Band tone="sage">
    <h1>Contact</h1>
    <p>
    I'm happy to hear from prospective students, collaborators, journalists and anyone curious
    about my work. Send a message below, or email me directly at{' '}
    <a href="mailto:venezie@wustl.edu">venezie@wustl.edu</a>.
    </p>
  </Band>

  <Band tone="sand">

  <form action={FORM_ENDPOINT} method="POST">
    <label>
      Name
      <input type="text" name="name" required />
    </label>
    <label>
      Email
      <input type="email" name="email" required />
    </label>
    <label>
      Message
      <textarea name="message" rows="6" required></textarea>
    </label>
    <button type="submit">Send</button>
  </form>
  </Band>
</Layout>
