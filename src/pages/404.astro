---
import Layout from '../layouts/Layout.astro';
import Band from '../components/Band.astro';
import Brain from '../components/Brain.astro';
---

<Layout title="Page not found">
  <Band tone="sage">
    <div class="lost">
      <Brain />
      <h1>404: this page got lost in the folds</h1>
      <p>I couldn't find that page. Try heading back <a href="/">home</a>.</p>
    </div>
  </Band>
</Layout>

<style>
  .lost { text-align: center; }
  .lost p { margin-left: auto; margin-right: auto; }
</style>
