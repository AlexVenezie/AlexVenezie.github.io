---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const entries = (await getCollection('ask')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const answered = await Promise.all(
  entries.map(async (e) => ({ entry: e, Content: (await render(e)).Content })),
);

// TODO: create a free form at https://formspree.io and paste your form endpoint here.
// A static site cannot receive messages itself, so this posts to that service, which emails you.
const FORM_ENDPOINT = 'https://formspree.io/f/YOUR_FORM_ID';
---

<Layout title="Ask Me Anything">
  <h1>Ask Me Anything</h1>
  <p>
    Curious about research, grad school, engineering careers or anything else? Send a question.
    I'll answer the best ones below.
  </p>

  <form action={FORM_ENDPOINT} method="POST">
    <label>
      Your question
      <textarea name="question" rows="5" required></textarea>
    </label>
    <label>
      Your email (optional, only if you want a direct reply)
      <input type="email" name="email" />
    </label>
    <button type="submit">Send</button>
  </form>

  <h2>Answered questions</h2>
  {answered.map(({ entry, Content }) => (
    <div class="card">
      <span class="date">{entry.data.date.toLocaleDateString('en-US', { dateStyle: 'long', timeZone: 'UTC' })}</span>
      <h3>{entry.data.question}</h3>
      <Content />
    </div>
  ))}
</Layout>
