---
import '../styles/global.css';
import Links from '../components/Links.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/news/', label: 'News' },
  { href: '/research/', label: 'Research' },
  { href: '/teaching/', label: 'Teaching' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
const description =
  'Alex Venezie: PhD student in mechanical engineering at Washington University in St. Louis, studying the mechanics of traumatic brain injury.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Alex Venezie</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | Alex Venezie`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header>
      <div class="wrap bar">
        <a class="name" href="/">Alex Venezie</a>
        <nav>
          {nav.map((n) => (
            <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="wrap">
        <div class="panel">
          <Links />
          <small>© {new Date().getFullYear()} Alex Venezie</small>
        </div>
      </div>
    </footer>
  </body>
</html>
